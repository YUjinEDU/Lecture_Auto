# LLM (OpenAI-compatible gateway; read by lecture_auto/llm/openai_client.py)
FACTCHAT_API_KEY=your-api-key
FACTCHAT_BASE_URL=https://your-gateway.example/v1
# Optional model overrides (FACTCHAT_MODEL outranks LLM_SCRIPT_MODEL)
# FACTCHAT_MODEL=
# LLM_SCRIPT_MODEL=
# LLM_VLM_MODEL=

# Professor web UI (docs/WEB_UI.md): pass on the command line or set here; the server
# refuses to start without a password.
LECTURE_WEB_PASSWORD=choose-a-password
# GPU index for production jobs (never GPU 1 -- it belongs to someone else)
LECTURE_WEB_GPU=0

# Rendering
SOFFICE_BIN=soffice
RENDER_DPI=150

# Legacy per-job output root (run.py / storage helpers)
JOB_OUTPUT_ROOT=/data/work
