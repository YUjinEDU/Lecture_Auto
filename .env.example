# Lecture Auto configuration. Copy to .env and fill in. Never commit .env.

# --- Web UI -----------------------------------------------------------------
# Password of the first admin account (admin@local), used only on an empty database.
LECTURE_WEB_PASSWORD=choose-a-strong-password
# LECTURE_WEB_ADMIN_EMAIL=admin@local
# Signup mode: closed (default) | open | invite
LECTURE_WEB_SIGNUP=closed
# on: allow local Raon-Speech voice cloning (needs a GPU and the `gpu` extra); off: hosted TTS only
LECTURE_WEB_RAON=off
# GPU index used for Raon jobs (nvidia-smi numbering)
LECTURE_WEB_GPU=0
# Optional limits (per account): lectures, voices, upload sizes, storage
# LECTURE_WEB_MAX_LECTURES=30
# LECTURE_WEB_MAX_VOICES=10
# LECTURE_WEB_MAX_UPLOAD_MB=300
# LECTURE_WEB_MAX_VOICE_UPLOAD_MB=50
# LECTURE_WEB_STORAGE_LIMIT_MB=5120
# OpenAI-compatible endpoint that keys users register in Settings are sent to
# LECTURE_WEB_KEY_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# --- LLM: script generation + slide vision (any OpenAI-compatible endpoint) --
# Either the OPENAI_* pair or the FACTCHAT_* pair; FACTCHAT_* wins when both are set.
OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# FACTCHAT_API_KEY=
# FACTCHAT_BASE_URL=https://your-gateway.example/v1
# Model names (defaults target the BAZE/FactChat gateway; set these for plain OpenAI)
# LLM_SCRIPT_MODEL=gpt-4.1
# LLM_VLM_MODEL=gpt-4.1-mini

# --- Hosted TTS (OpenAI-compatible POST /audio/speech) ----------------------
# BAZE_API_KEY=
# BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# BAZE_TTS_MAX_IN_FLIGHT=8
# Seconds before a stalled TTS request is retried (requests normally answer in 3-5 s)
# BAZE_TTS_TIMEOUT=30

# --- Rendering ---------------------------------------------------------------
SOFFICE_BIN=soffice
RENDER_DPI=150
