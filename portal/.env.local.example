# Server-only base URL of the internal GPU FastAPI server.
#
# Used ONLY by the same-origin reverse proxy route handler
# (portal/app/api/gpu/[...path]/route.ts), which runs on the NAS Node server
# (the sdlab_web container). It is NOT exposed to the browser — there is no
# NEXT_PUBLIC_ prefix — so the GPU box stays off the public internet.
#
# Set this to the GPU server's LAN address reachable from the sdlab_web
# container (default docker bridge usually routes container -> host -> LAN).
GPU_API_URL=http://<gpu-lan-ip>:8000
